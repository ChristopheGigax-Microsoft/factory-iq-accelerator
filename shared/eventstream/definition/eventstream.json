{
  "name": "eventstream-baseline",
  "description": "Baseline Eventstream for factory telemetry landing. Routes real-time equipment data to the Eventhouse KQL database.",
  "compatibilityLevel": "1.1",
  "inputs": [
    {
      "id": "custom-app-input",
      "type": "CustomApp",
      "displayName": "Custom App Input"
    }
  ],
  "outputs": [
    {
      "id": "eventhouse-output",
      "type": "Eventhouse",
      "displayName": "Eventhouse Output",
      "destination": {
        "table": "RawTelemetry"
      }
    }
  ],
  "routes": [
    {
      "from": "custom-app-input",
      "to": "eventhouse-output"
    }
  ]
}
