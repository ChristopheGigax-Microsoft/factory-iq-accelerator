.create-or-alter function with (folder='ingest') fn_transform_telemetry() {
  TelemetryLanding
  | project Timestamp, WorkUnitId, Signal, Value
}

.alter table EquipmentTelemetry policy update @'[{"IsEnabled": true, "Source": "TelemetryLanding", "Query": "TelemetryLanding | project Timestamp, WorkUnitId, Signal, Value", "IsTransactional": false, "PropagateIngestionProperties": true}]'
