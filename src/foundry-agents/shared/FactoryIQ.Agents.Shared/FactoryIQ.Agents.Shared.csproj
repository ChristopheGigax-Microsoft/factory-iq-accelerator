    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FactoryIQ.Agents.Shared</RootNamespace>
    <NoWarn>$(NoWarn);CA2252;OPENAI001;SCME0001</NoWarn>
