        { "name": "WorkCenterId", "type": "string" },
        { "name": "RequestId", "type": "string" },
        { "name": "Direction", "type": "string" },
        { "name": "Quantity", "type": "real" },
        { "name": "UnitOfMeasure", "type": "string" }
      ],
      "transformFile": "transforms/material-actual.kql"
    },
    {
      "name": "quality_test_result",
      "targetTable": "QualityTestResult",
      "enabled": true,
      "transactional": false,
      "columns": [
        { "name": "Timestamp", "type": "datetime" },
        { "name": "TestId", "type": "string" },
        { "name": "WorkUnitId", "type": "string" },
        { "name": "ResponseId", "type": "string" },
        { "name": "LotId", "type": "string" },
        { "name": "TestSpecificationId", "type": "string" },
        { "name": "Parameter", "type": "string" },
        { "name": "MeasuredValue", "type": "real" },
        { "name": "LowerLimit", "type": "real" },
        { "name": "UpperLimit", "type": "real" },
        { "name": "UnitOfMeasure", "type": "string" },
        { "name": "Result", "type": "string" },
        { "name": "Severity", "type": "string" }
      ],
      "transformFile": "transforms/quality-test-result.kql"
    }
