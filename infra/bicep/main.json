{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "10071922290046909750"
    }
  },
  "parameters": {
    "plantCode": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "capacitySku": {
      "type": "string",
      "defaultValue": "F2"
    },
    "deploymentTimestamp": {
      "type": "string",
      "defaultValue": "[utcNow()]"
    }
