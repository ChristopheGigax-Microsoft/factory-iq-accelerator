  "queries": [
    {
      "id": "2d9f4d60-4372-49f7-9687-9f1f2d4a31ca",
      "text": "EquipmentActual\n| where Timestamp between (_startTime .. _endTime)\n| summarize StateEvents=count() by WorkUnitId, State\n| order by StateEvents desc",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "9a9f91ee-3d69-4f4a-8eb8-fd2d0920a622"
      },
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "3e5e23a4-e74a-4b35-a9a2-32b7da57fe73",
      "text": "EquipmentTelemetry\n| where Timestamp between (_startTime .. _endTime)\n| summarize Samples=count() by TimeBucket=bin(Timestamp, 1m), WorkUnitId\n| order by TimeBucket asc",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "9a9f91ee-3d69-4f4a-8eb8-fd2d0920a622"
      },
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "8ed638de-f80e-4f96-a5c7-8763d743f4d8",
      "text": "WorkResponse\n| where coalesce(CompletedAt, ActualEnd, ActualStart) between (_startTime .. _endTime)\n| summarize Good=sum(QuantityProduced), Reject=sum(QuantityRejected), Responses=count() by WorkCenterId\n| order by Good desc",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "9a9f91ee-3d69-4f4a-8eb8-fd2d0920a622"
      },
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    },
    {
      "id": "f65044f0-974b-47bc-972f-fb70e4c99222",
      "text": "QualityTestResult\n| where Timestamp between (_startTime .. _endTime)\n| summarize Samples=count() by Result\n| order by Samples desc",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "9a9f91ee-3d69-4f4a-8eb8-fd2d0920a622"
      },
      "usedVariables": [
        "_startTime",
        "_endTime"
      ]
    }
  ],
  "schema_version": "52",
  "title": "Factory IQ Real-Time Machine Performance"
